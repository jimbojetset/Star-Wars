<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;Web/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.20"
                      Condition="('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '' And $([MSBuild]::IsOSPlatform('OSX'))) Or $([System.String]::Copy('$(RuntimeIdentifier);$(RuntimeIdentifiers)').Contains('osx'))" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.20"
                      Condition="('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '' And $([MSBuild]::IsOSPlatform('Linux'))) Or $([System.String]::Copy('$(RuntimeIdentifier);$(RuntimeIdentifiers)').Contains('linux'))" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20"
                      Condition="('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '' And $([MSBuild]::IsOSPlatform('Windows'))) Or $([System.String]::Copy('$(RuntimeIdentifier);$(RuntimeIdentifiers)').Contains('win'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core/StarWars.Core.csproj" />
    <None Update="Roms/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
