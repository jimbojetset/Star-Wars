<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.20" />
    <PackageReference Include="SDL3-CS.MacOS" Version="3.4.20" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.20" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.20" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Roms/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
