<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" PrivateAssets="all" />
    <ProjectReference Include="../Core/StarWars.Core.csproj" />
    <ArcadeRom Include="../Roms/136021*" />
  </ItemGroup>

  <Target Name="RunPublishedCabinet" AfterTargets="ComputeRunArguments" Condition="'$(RunInterpreted)' != 'true'">
    <PropertyGroup>
      <CabinetPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseOutputPath)', 'Release', '$(TargetFramework)', 'publish'))</CabinetPublishDir>
      <RunArguments>&quot;$(_BlazorDevServerDll)&quot; --applicationpath &quot;$(CabinetPublishDir)$(AssemblyName).dll&quot; --webroot &quot;$([MSBuild]::NormalizePath('$(CabinetPublishDir)', 'wwwroot'))&quot; --urls http://localhost:8080</RunArguments>
    </PropertyGroup>
    <Error Condition="!Exists('$(CabinetPublishDir)wwwroot/index.html') Or !Exists('$(CabinetPublishDir)$(AssemblyName).staticwebassets.endpoints.json')"
           Text="Publish the optimized cabinet first with 'dotnet publish Web/StarWars.Web.csproj -c Release'. For the interpreted development build, use '-p:RunInterpreted=true'." />
  </Target>

  <Target Name="ResolveArcadeRomAssets" BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'@(ArcadeRom)' != ''">
    <PropertyGroup>
      <ArcadeAssetRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'arcade-assets'))</ArcadeAssetRoot>
    </PropertyGroup>
    <Copy SourceFiles="@(ArcadeRom)" DestinationFolder="$(ArcadeAssetRoot)roms" SkipUnchangedFiles="true">
      <Output TaskParameter="CopiedFiles" ItemName="StagedArcadeRom" />
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
    <ItemGroup>
      <StagedArcadeRom Update="@(StagedArcadeRom)" RelativePath="roms/%(Filename)%(Extension)" />
    </ItemGroup>
    <DefineStaticWebAssets CandidateAssets="@(StagedArcadeRom)" SourceType="Discovered" SourceId="$(PackageId)"
                           ContentRoot="$(ArcadeAssetRoot)" BasePath="$(StaticWebAssetBasePath)"
                           AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_CurrentProjectStaticWebAsset" />
    </DefineStaticWebAssets>
  </Target>
</Project>
